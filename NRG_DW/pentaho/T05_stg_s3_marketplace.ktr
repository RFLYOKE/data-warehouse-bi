<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Script</jsScript_name><jsScript_script><![CDATA[
function T(x) { if (x == null) return null; var s = ("" + x).replace(/^\s+|\s+$/g, ""); return s.length == 0 ? null : s; }
function NUM(x) { var s = T(x); return s == null ? null : parseFloat(s); }
function INT(x) { var s = T(x); return s == null ? null : parseInt(s, 10); }
function R2(x) { return Math.round(x * 100) / 100; }

var paid_utc = str2date(T(paid_at), "yyyy-MM-dd'T'HH:mm:ss'Z'");
var paid_wib = new Date(paid_utc.getTime() + 7 * 3600 * 1000);
var diambil_d = str2date(T(diambil_pada), "yyyy-MM-dd'T'HH:mm:ss");
var qty_i = INT(qty); var price_n = NUM(price); var voucher_n = NUM(voucher); if (voucher_n == null) voucher_n = 0;
var commission_n = NUM(commission); if (commission_n == null) commission_n = 0;
var service_n = NUM(service); if (service_n == null) service_n = 0;
var price_excl = R2(price_n / 1.11); var voucher_excl = R2(voucher_n / 1.11);
var gross_line_incl = qty_i * price_n;
var sku_c = T(seller_sku); var invoice_c = T(invoice);
var material_no = "P-" + sku_c.substring(sku_c.length - 4);
var kota_upper = T(buyer_city) == null ? null : T(buyer_city).toUpperCase().replace(/\s+/g, " ");
]]></jsScript_script></jsScript></jsScripts><fields><field><name>paid_utc</name><rename>paid_utc</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>paid_wib</name><rename>paid_wib</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>diambil_d</name><rename>diambil_d</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>qty_i</name><rename>qty_i</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>price_n</name><rename>price_n</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>voucher_n</name><rename>voucher_n</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>commission_n</name><rename>commission_n</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>service_n</name><rename>service_n</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>price_excl</name><rename>price_excl</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>voucher_excl</name><rename>voucher_excl</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>gross_line_incl</name><rename>gross_line_incl</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>sku_c</name><rename>sku_c</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>invoice_c</name><rename>invoice_c</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>material_no</name><rename>material_no</r