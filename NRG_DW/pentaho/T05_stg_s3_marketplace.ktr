<GUI><xloc>1140</xloc><yloc>200</yloc><draw>Y</draw></GUI></step><step><name>Alokasi fee proporsional</name><type>ScriptValueMod</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Script</jsScript_name><jsScript_script><![CDATA[
function T(x) { if (x == null) return null; var s = ("" + x).replace(/^\s+|\s+$/g, ""); return s.length == 0 ? null : s; }
function NUM(x) { var s = T(x); return s == null ? null : parseFloat(s); }
function INT(x) { var s = T(x); return s == null ? null : parseInt(s, 10); }
function R2(x) { return Math.round(x * 100) / 100; }

var share = gross_sum > 0 ? gross_line_incl / gross_sum : 0;
var fee_komisi_alok = R2(commission_n * share);
var fee_layanan_alok = R2(service_n * share);
]]></jsScript_script></jsScript></jsScripts><fields><field><name>fee_komisi_alok</name><rename>fee_komisi_alok</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>fee_layanan_alok</name><rename>fee_layanan_alok</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
