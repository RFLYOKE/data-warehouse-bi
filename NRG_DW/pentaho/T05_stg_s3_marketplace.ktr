function INT(x) { var s = T(x); return s == null ? null : parseInt(s, 10); }
function R2(x) { return Math.round(x * 100) / 100; }
var kota_final = T(kota_lookup) != null ? T(kota_lookup) : T(buyer_city);]]></jsScript_script></jsScript></jsScripts><fields><field><name>kota_final</name><rename>kota_final</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
