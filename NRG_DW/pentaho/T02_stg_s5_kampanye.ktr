<compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Script</jsScript_name><jsScript_script><![CDATA[
function T(x) { if (x == null) return null; var s = ("" + x).replace(/^\s+|\s+$/g, ""); return s.length == 0 ? null : s; }
function NUM(x) { var s = T(x); return s == null ? null : parseFloat(s); }
function INT(x) { var s = T(x); return s == null ? null : parseInt(s, 10); }
function R2(x) { return Math.round(x * 100) / 100; }

var status_baris = "OK"; var alasan = ""; 
var kode_norm = null, nama_n = null, jenis_n = null, kanal_n = null, pic_n = null;
var tgl_mulai_d = null, tgl_selesai_d = null, target_n = null;
var waktu_etl = new Date();
if (T(kode_promo) == null && T(nama_kampanye) == null && T(tgl_mulai) == null && T(tgl_selesai) == null && T(target_diskon_persen) == null) {
    status_baris = "KOSONG"; alasan = "Baris kosong";
} else {
    kode_norm = T(kode_promo) == null ? null : T(kode_promo).toUpperCase().replace(/\s+/g, "");
    nama_n = T(nama_kampanye); jenis_n = T(jenis_promo); kanal_n = T(kanal); pic_n = T(pic);
    var tt = T(target_diskon_persen);
    if (kode_norm == null) { status_baris = "ERROR"; alasan = "kode_promo kosong"; }
    else if (tt == null || !/^[0-9]+(\.[0-9]+)?$/.test(tt)) {
        status_baris = "ERROR"; alasan = "target_diskon_persen bukan angka: '" + tt + "'";
    } else {
        target_n = parseFloat(tt);
        try { tgl_mulai_d = str2date(T(tgl_mulai), "dd-MM-yyyy"); tgl_selesai_d = str2date(T(tgl_selesai), "dd-MM-yyyy"); }
        catch (e) { status_baris = "ERROR"; alasan = "format tanggal tidak valid"; }
    }
}
]]></jsScript_script></jsScript></jsScripts><fields><field><name>status_baris</name><rename>status_baris</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>alasan</name><rename>alasan</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>kode_norm</name><rename>kode_norm</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>nama_n</name><rename>nama_n</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>jenis_n</name><rename>jenis_n</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>kanal_n</name><rename>kanal_n</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>pic_n</name><rename>pic_n</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>tgl_mulai_d</name><rename>tgl_mulai_d</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>tgl_selesai_d</name><rename>tgl_selesai_d</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>target_n</name><rename>target_n</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>waktu_etl</name><rename>waktu_etl</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
