<order><hop><from>Ekstrak transaksi (S1, S2, S3)</from><to>Hitung bersih, HPP, margin kotor</to><enabled>Y</enabled></hop><hop><from>Hitung bersih, HPP, margin kotor</from><to>fact_penjualan</to><enabled>Y</enabled></hop></order>
<step><name>Ekstrak transaksi (S1, S2, S3)</name><type>TableInput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_DW</connection><sql><![CDATA[SELECT 'S1_WEB' AS sumber_sistem, l.order_id AS no_transaksi, CAST(l.line_no AS SIGNED) AS no_baris,
       CAST(DATE_FORMAT(l.order_ts, '%Y%m%d') AS UNSIGNED) AS tanggal_key, l.order_ts AS waktu_wib,
       p.produk_key, COALESCE(pl.pelanggan_key, -1) AS pelanggan_key, tk.toko_kanal_key,
       CAST(CASE WHEN l.voucher_id IS NOT NULL AND l.disc_amount_incl > 0 THEN COALESCE(k.kampanye_key, -2) ELSE -1 END AS SIGNED) AS kampanye_key,
       CAST(COALESCE(mb.metode_bayar_key, -1) AS SIGNED) AS metode_bayar_key,
       CAST(l.qty AS SIGNED) AS qty, l.unit_price_excl AS harga_satuan, l.disc_excl AS diskon_excl, p.harga_pokok AS hpp_satuan,
       CAST(0 AS DECIMAL(18,2)) AS fee_komisi, CAST(0 AS DECIMAL(18,2)) AS fee_layanan, CAST(l.qty_retur AS SIGNED) AS qty_retur, CAST(l.refund_excl AS DECIMAL(18,2)) AS nilai_retur
FROM stg_s1_order_line l
JOIN map_produk mp ON mp.sumber = 'S1' AND mp.kode_sumber = l.sku
JOIN dim_produk p  ON p.material_no = mp.material_no AND DATE(l.order_ts) BETWEEN p.tgl_efektif_awal AND p.tgl_efektif_akhir
JOIN dim_toko_kanal tk ON tk.kode_toko_kanal = 'WEB'
LEFT JOIN dim_pelanggan pl ON pl.customer_id_web = l.customer_id
LEFT JOIN dim_kampanye k ON k.kode_promo = l.promo_code AND k.tgl_mulai = l.voucher_valid_from
LEFT JOIN dim_metode_bayar mb ON mb.metode_bayar = l.payment_method
WHERE l.status <> 'DIBATALKAN'
UNION ALL
SELECT 'S2_POS' AS sumber_sistem, l.trx_no AS no_transaksi, CAST(l.line_seq AS SIGNED) AS no_baris,
       CAST(DATE_FORMAT(h.trx_date, '%Y%m%d') AS UNSIGNED) AS tanggal_key, CAST(h.trx_date AS DATETIME) AS waktu_wib,
       p.produk_key, COALESCE(pl.pelanggan_key, -1) AS pelanggan_key, tk.toko_kanal_key,
       CAST(CASE WHEN l.disc_pct > 0 THEN 
COALESCE((SELECT k.kampanye_key FROM dim_kampanye k
           WHERE k.kampanye_key > 0 AND h.trx_date BETWEEN k.tgl_mulai AND k.tgl_selesai
             AND k.kanal_target IN ('Semua Kanal', 'Toko Fisik')
           ORDER BY (k.kanal_target = 'Semua Kanal'), k.tgl_mulai DESC LIMIT 1), -1) ELSE -1 END AS SIGNED) AS kampanye_key,
       CAST(COALESCE(mb.metode_bayar_key, -1) AS SIGNED) AS metode_bayar_key,
       CAST(l.qty AS SIGNED) AS qty, l.unit_price_excl AS harga_satuan, ROUND(l.qty * l.unit_price_excl * l.disc_pct / 100, 2) AS diskon_excl,
       p.harga_pokok AS hpp_satuan, CAST(0 AS DECIMAL(18,2)) AS fee_komisi, CAST(0 AS DECIMAL(18,2)) AS fee_layanan, CAST(0 AS SIGNED) AS qty_retur, CAST(0 AS DECIMAL(18,2)) AS nilai_retur
FROM stg_s2_trx_line l
JOIN stg_s2_trx_header h ON h.trx_no = l.trx_no
LEFT JOIN stg_s2_trx_payment pay ON pay.trx_no = l.trx_no
JOIN map_produk mp ON mp.sumber = 'S2' AND mp.kode_sumber = l.item_code
JOIN dim_produk p  ON p.material_no = mp.material_no AND h.trx_date BETWEEN p.tgl_efektif_awal AND p.tgl_efektif_akhir
JOIN dim_toko_kanal tk ON tk.kode_toko_kanal = h.store_code
LEFT JOIN dim_pelanggan pl ON pl.member_no = h.member_no
LEFT JOIN dim_metode_bayar mb ON mb.metode_bayar = CASE WHEN h.payment_type = 'SPLIT' OR COALESCE(pay.jml_baris_bayar, 1) > 1 THEN 'SPLIT' ELSE h.payment_type END
UNION ALL
SELECT 'S3_MPL' AS sumber_sistem, s.invoice AS no_transaksi,
       CAST(ROW_NUMBER() OVER (PARTITION BY s.invoice ORDER BY s.seller_sku) AS SIGNED) AS no_baris,
       CAST(DATE_FORMAT(s.paid_at_wib, '%Y%m%d') AS UNSIGNED) AS tanggal_key, s.paid_at_wib AS waktu_wib,
       p.produk_key, COALESCE(pl.pelanggan_key, -1) AS pelanggan_key, tk.toko_kanal_key,
       CAST(CASE WHEN s.voucher_excl > 0 THEN 
COALESCE((SELECT k.kampanye_key FROM dim_kampanye k
           WHERE k.kampanye_key > 0 AND DATE(s.paid_at_wib) BETWEEN k.tgl_mulai AND k.tgl_selesai
             AND k.kanal_target IN ('Semua Kanal', 'Marketplace')
           ORDER BY (k.kanal_target = 'Semua Kanal'), k.tgl_mulai DESC LIMIT 1), -1) ELSE -1 END AS SIGNED) AS kampanye_key,
       CAST(-1 AS SIGNED) AS metode_bayar_key,
       CAST(s.qty AS SIGNED) AS qty, s.unit_price_excl AS harga_satuan, s.voucher_excl AS diskon_excl, p.harga_pokok AS hpp_satuan,
       s.fee_komisi_alokasi AS fee_komisi, s.fee_layanan_alokasi AS fee_layanan, CAST(0 AS SIGNED) AS qty_retur, CAST(0 AS DECIMAL(18,2)) AS nilai_retur
FROM stg_s3_inv_item s
JOIN map_produk mp ON mp.sumber = 'S3' AND mp.kode_sumber = s.seller_sku
JOIN dim_produk p  ON p.material_no = mp.material_no AND DATE(s.paid_at_wib) BETWEEN p.tgl_efektif_awal AND p.tgl_efektif_akhir
JOIN dim_toko_kanal tk ON tk.kode_toko_kanal = CASE s.channel WHEN 'marketplace_a' THEN 'MPL_A' ELSE 'MPL_B' END
LEFT JOIN dim_pelanggan pl ON pl.mpl_buyer_hash = s.buyer_hash]]></sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>120</xloc><yloc>180</yloc><draw>Y</draw></GUI></step><step><name>Hitung bersih, HPP, margin kotor</name><type>ScriptValueMod</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Script</jsScript_name><jsScript_script><![CDATA[
function T(x) { if (x == null) return null; var s = ("" + x).replace(/^\s+|\s+$/g, ""); return s.length == 0 ? null : s; }
function NUM(x) { var s = T(x); return s == null ? null : parseFloat(s); }
function INT(x) { var s = T(x); return s == null ? null : parseInt(s, 10); }
function R2(x) { return Math.round(x * 100) / 100; }

var penjualan_kotor = R2(qty * harga_satuan);
var penjualan_bersih = R2(penjualan_kotor - diskon_excl);
var hpp_total = (hpp_satuan == null) ? null : R2(qty * hpp_satuan);
var margin_kotor = (hpp_total == null) ? null : R2(penjualan_bersih - hpp_total - fee_komisi - fee_layanan);
]]></jsScript_script></jsScript></jsScripts><fields><field><name>penjualan_kotor</name><rename>penjualan_kotor</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>penjualan_bersih</name><rename>penjualan_bersih</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>hpp_total</name><rename>hpp_total</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>margin_kotor</name><rename>margin_kotor</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>460</xloc><yloc>180</yloc><draw>Y</draw></GUI></step><step><name>fact_penjualan</name><type>TableOutput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_DW</connection><schema/><table>fact_penjualan</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_daily>N</partitioning_daily><partitioning_monthly>Y</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_field/><tablename_in_table>Y</tablename_in_table><return_keys>N</return_keys><return_field/><fields><field><column_name>sumber_sistem</column_name><stream_name>sumber_sistem</stream_name></field><field><column_name>no_transaksi</column_name><stream_name>no_transaksi</stream_name></field><field><column_name>no_baris</column_name><stream_name>no_baris</stream_name></field><field><column_name>tanggal_key</column_name><stream_name>tanggal_key</stream_name></field><field><column_name>waktu_transaksi_wib</column_name><stream_name>waktu_wib</stream_name></field><field><column_name>produk_key</column_name><stream_name>produk_key</stream_name></field><field><column_name>pelanggan_key</column_name><stream_name>pelanggan_key</stream_name></field><field><column_name>toko_kanal_key</column_name><stream_name>toko_kanal_key</stream_name></field><field><column_name>kampanye_key</column_name><stream_name>kampanye_key</stream_name></field><field><column_name>metode_bayar_key</column_name><stream_name>metode_bayar_key</stream_name></field><field><column_name>qty</column_name><stream_name>qty</stream_name></field><field><column_name>harga_satuan_excl_ppn</column_name><stream_name>harga_satuan</stream_name></field><field><column_name>penjualan_kotor_excl</column_name><stream_name>penjualan_kotor</stream_name></field><field><column_name>diskon_excl_ppn</column_name><stream_name>diskon_excl</stream_name></field><field><column_name>penjualan_bersih_excl</column_name><stream_name>penjualan_bersih</stream_name></field><field><column_name>harga_pokok_satuan</column_name><stream_name>hpp_satuan</stream_name></field><field><column_name>harga_pokok_total</column_name><stream_name>hpp_total</stream_name></field><field><column_name>fee_komisi</column_name><stream_name>fee_komisi</stream_name></field><field><column_name>fee_layanan</column_name><stream_name>fee_layanan</stream_name></field><field><column_name>margin_kotor</column_name><stream_name>margin_kotor</stream_name></field><field><column_name>qty_retur</column_name><stream_name>qty_retur</stream_name></field><field><column_name>nilai_retur_excl_ppn</column_name><stream_name>nilai_retur</stream_name></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>780</xloc><yloc>180</yloc><draw>Y</draw></GUI></step>
