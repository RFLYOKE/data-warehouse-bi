<GUI><xloc>480</xloc><yloc>420</yloc><draw>Y</draw></GUI></step><step><name>Metode bayar (S1 + S2 + SPLIT)</name><type>TableInput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_DW</connection><sql><![CDATA[
SELECT m.metode_bayar,
       CASE WHEN m.metode_bayar IN ('CASH','TUNAI') THEN 'Tunai'
            WHEN m.metode_bayar = 'SPLIT' THEN 'Campuran'
            ELSE 'Non-tunai' END AS kelompok_bayar
FROM (
  SELECT DISTINCT payment_method AS metode_bayar FROM stg_s1_order_line WHERE payment_method IS NOT NULL
  UNION SELECT DISTINCT payment_type FROM stg_s2_trx_header WHERE payment_type IS NOT NULL
  UNION SELECT 'SPLIT'
) m
]]></sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>80</xloc><yloc>540</yloc><draw>Y</draw></GUI></step><step><name>dim_metode_bayar</name><type>TableOutput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
