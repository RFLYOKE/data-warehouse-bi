<step><name>map_produk (S1,S2,S3 -> material_no)</name><type>TableInput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_DW</connection><sql><![CDATA[
SELECT u.sumber, u.kode_sumber, u.material_no, u.aturan,
       CASE WHEN EXISTS (SELECT 1 FROM stg_erp_produk e WHERE e.material_no = u.material_no) THEN 'Y' ELSE 'N' END AS terdaftar_erp
FROM (
  SELECT 'S1' AS sumber, sku AS kode_sumber, MAX(material_no) AS material_no, 'SKU-<nomor>-xxx -> P-<nomor>; selain itu dipakai apa adanya (late arriving)' AS aturan
    FROM stg_s1_order_line GROUP BY sku
  UNION ALL
  SELECT 'S2', item_code, item_code, 'item_code = material_no' FROM (SELECT DISTINCT item_code FROM stg_s2_trx_line) s2
  UNION ALL
  SELECT 'S3', seller_sku, MAX(material_no), 'seller_sku: 4 digit terakhir -> P-<nomor>' FROM stg_s3_inv_item GROUP BY seller_sku
) u
]]></sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>80</xloc><yloc>60</yloc><draw>Y</draw></GUI></step><step><name>map_produk</name><type>TableOutput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_DW</connection><schema/><table>map_produk</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_daily>N</partitioning_daily><partitioning_monthly>Y</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_field/><tablename_in_table>Y</tablename_in_table><return_keys>N</return_keys><return_field/><fields><field><column_name>sumber</column_name><stream_name>sumber</stream_name></field><field><column_name>kode_sumber</column_name><stream_name>kode_sumber</stream_name></field><field><column_name>material_no</column_name><stream_name>material_no</stream_name></field><field><column_name>aturan</column_name><stream_name>aturan</stream_name></field><field><column_name>terdaftar_erp</column_name><stream_name>terdaftar_erp</stream_name></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>480</xloc><yloc>60</yloc><draw>Y</draw></GUI></step><step><name>Bangun dim_tanggal (2022-2023)</name><type>TableInput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_DW</connection><sql><![CDATA[
WITH RECURSIVE d(tgl) AS (
  SELECT DATE('2022-01-01') UNION ALL SELECT DATE_ADD(tgl, INTERVAL 1 DAY) FROM d WHERE tgl < DATE('2023-12-31')
)
SELECT CAST(DATE_FORMAT(tgl, '%Y%m%d') AS UNSIGNED) AS tanggal_key, tgl AS tanggal, DAY(tgl) AS hari,
       ELT(WEEKDAY(tgl) + 1, 'Senin','Selasa','Rabu','Kamis','Jumat','Sabtu','Minggu') AS nama_hari,
       WEEK(tgl, 3) AS minggu_ke, MONTH(tgl) AS bulan,
       ELT(MONTH(tgl), 'Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember') AS nama_bulan,
       QUARTER(tgl) AS kuartal, YEAR(tgl) AS tahun, CONCAT(YEAR(tgl), '-Q', QUARTER(tgl)) AS tahun_kuartal,
       CASE WHEN WEEKDAY(tgl) >= 5 THEN 'Y' ELSE 'N' END AS is_weekend
FROM d
]]></sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>80</xloc><yloc>180</yloc><draw>Y</draw></GUI></step><step><name>dim_tanggal</name><type>TableOutput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_DW</connection><schema/><table>dim_tanggal</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_daily>N</partitioning_daily><partitioning_monthly>Y</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_field/><tablename_in_table>Y</tablename_in_table><return_keys>N</return_keys><return_field/><fields><field><column_name>tanggal_key</column_name><stream_name>tanggal_key</stream_name></field><field><column_name>tanggal</column_name><stream_name>tanggal</stream_name></field><field><column_name>hari</column_name><stream_name>hari</stream_name></field><field><column_name>nama_hari</column_name><stream_name>nama_hari</stream_name></field><field><column_name>minggu_ke</column_name><stream_name>minggu_ke</stream_name></field><field><column_name>bulan</column_name><stream_name>bulan</stream_name></field><field><column_name>nama_bulan</column_name><stream_name>nama_bulan</stream_name></field><field><column_name>kuartal</column_name><stream_name>kuartal</stream_name></field><field><column_name>tahun</column_name><stream_name>tahun</stream_name></field><field><column_name>tahun_kuartal</column_name><stream_name>tahun_kuartal</stream_name></field><field><column_name>is_weekend</column_name><stream_name>is_weekend</stream_name></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>480</xloc><yloc>180</yloc><draw>Y</draw></GUI></step><step><name>Toko dan kanal (S2 store_master + WEB + MPL)</name><type>TableInput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_DW</connection><sql><![CDATA[
SELECT store_code AS kode_toko_kanal, store_name AS nama_toko_kanal, 'Toko Fisik' AS kanal, 'POS Toko' AS platform,
       kota_baku, province AS provinsi, format_toko, 'S2_POS' AS sistem_sumber
  FROM stg_s2_store
UNION ALL SELECT 'WEB',   'Situs Web NRG',  'Situs Web',   'Website NRG',   NULL, NULL, NULL, 'S1_WEB'
UNION ALL SELECT 'MPL_A', 'Marketplace A',  'Marketplace', 'marketplace_a', NULL, NULL, NULL, 'S3_MPL'
UNION ALL SELECT 'MPL_B', 'Marketplace B',  'Marketplace', 'marketplace_b', NULL, NULL, NULL, 'S3_MPL'
]]></sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>80</xloc><yloc>300</yloc><draw>Y</draw></GUI></step><step><name>dim_toko_kanal</name><type>TableOutput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_DW</connection><schema/><table>dim_toko_kanal</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_daily>N</partitioning_daily><partitioning_monthly>Y</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_field/><tablename_in_table>Y</tablename_in_table><return_keys>N</return_keys><return_field/><fields><field><column_name>kode_toko_kanal</column_name><stream_name>kode_toko_kanal</stream_name></field><field><column_name>nama_toko_kanal</column_name><stream_name>nama_toko_kanal</stream_name></field><field><column_name>kanal</column_name><stream_name>kanal</stream_name></field><field><column_name>platform</column_name><stream_name>platform</stream_name></field><field><column_name>kota_baku</column_name><stream_name>kota_baku</stream_name></field><field><column_name>provinsi</column_name><stream_name>provinsi</stream_name></field><field><column_name>format_toko</column_name><stream_name>format_toko</stream_name></field><field><column_name>sistem_sumber</column_name><stream_name>sistem_sumber</stream_name></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>480</xloc><yloc>300</yloc><draw>Y</draw></GUI></step><step><name>Kampanye valid (S5)</name><type>TableInput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_DW</connection><sql><![CDATA[
SELECT kode_promo, nama_kampanye, jenis_promo, kanal AS kanal_target, tgl_mulai, tgl_selesai, target_diskon_persen, pic,
       'VALID' AS status_validasi
FROM stg_s5_kampanye
]]></sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input/><output/></remotesteps>
