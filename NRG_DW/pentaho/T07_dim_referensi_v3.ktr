  <step>
    <name>Toko dan kanal (S2 store_master + WEB + MPL)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>NRG_DW</connection>
    <sql>SELECT 
    kode_toko_kanal, 
    MAX(nama_toko_kanal) AS nama_toko_kanal, 
    MAX(kanal) AS kanal, 
    MAX(platform) AS platform, 
    MAX(kota_baku) AS kota_baku, 
    MAX(provinsi) AS provinsi, 
    MAX(format_toko) AS format_toko, 
    MAX(sistem_sumber) AS sistem_sumber
FROM (
    SELECT store_code AS kode_toko_kanal, store_name AS nama_toko_kanal, 'Toko Fisik' AS kanal, 'POS Toko' AS platform, 
           kota_baku, province AS provinsi, format_toko, 'S2_POS' AS sistem_sumber
    FROM stg_s2_store
    
    UNION ALL 
    SELECT 'WEB', 'Situs Web NRG', 'Situs Web', 'Website NRG', NULL, NULL, NULL, 'S1_WEB'
    UNION ALL 
    SELECT 'MPL_A', 'Marketplace A', 'Marketplace', 'marketplace_a', NULL, NULL, NULL, 'S3_MPL'
    UNION ALL 
    SELECT 'MPL_B', 'Marketplace B', 'Marketplace', 'marketplace_b', NULL, NULL, NULL, 'S3_MPL'
) gabungan
GROUP BY kode_toko_kanal;</sql>
    <limit>0</limit>
    <lookup/>
