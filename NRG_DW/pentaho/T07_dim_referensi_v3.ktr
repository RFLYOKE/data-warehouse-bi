    </GUI>
  </step>
  <step>
    <name>Kampanye valid (S5)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>NRG_DW</connection>
    <sql>
SELECT kode_promo, nama_kampanye, jenis_promo, kanal AS kanal_target, tgl_mulai, tgl_selesai, target_diskon_persen, pic,
       'VALID' AS status_validasi
FROM stg_s5_kampanye
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>288</xloc>
      <yloc>416</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Metode bayar (S1 + S2 + SPLIT)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>NRG_DW</connection>
    <sql>
SELECT m.metode_bayar,
       CASE WHEN m.metode_bayar IN ('CASH','TUNAI') THEN 'Tunai'
            WHEN m.metode_bayar = 'SPLIT' THEN 'Campuran'
            ELSE 'Non-tunai' END AS kelompok_bayar
FROM (
  SELECT DISTINCT payment_method AS metode_bayar FROM stg_s1_order_line WHERE payment_method IS NOT NULL
  UNION SELECT DISTINCT payment_type FROM stg_s2_trx_header WHERE payment_type IS NOT NULL
  UNION SELECT 'SPLIT'
) m
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
