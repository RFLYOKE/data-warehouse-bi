<GUI><xloc>80</xloc><yloc>260</yloc><draw>Y</draw></GUI></step><step><name>Normalkan HP dan kota member</name><type>ScriptValueMod</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Script</jsScript_name><jsScript_script><![CDATA[
function T(x) { if (x == null) return null; var s = ("" + x).replace(/^\s+|\s+$/g, ""); return s.length == 0 ? null : s; }
function NUM(x) { var s = T(x); return s == null ? null : parseFloat(s); }
function INT(x) { var s = T(x); return s == null ? null : parseInt(s, 10); }
function R2(x) { return Math.round(x * 100) / 100; }

var d = T(hp) == null ? "" : T(hp).replace(/[^0-9]/g, "");
var phone_norm = null;
if (d.length > 0) {
    if (d.indexOf("62") == 0) phone_norm = d;
    else if (d.charAt(0) == "0") phone_norm = "62" + d.substring(1);
    else phone_norm = "62" + d;
}

var kota_upper = T(kota) == null ? null : T(kota).toUpperCase().replace(/\s+/g, " ");
var join_d = T(join_date) == null ? null : str2date(T(join_date), "yyyy-MM-dd");
]]></jsScript_script></jsScript></jsScripts><fields><field><name>phone_norm</name><rename>phone_norm</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>kota_upper</name><rename>kota_upper</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>join_d</name><rename>join_d</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
