<GUI><xloc>960</xloc><yloc>100</yloc><draw>Y</draw></GUI></step><step><name>S1 order_items + orders + voucher + retur</name><type>TableInput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_ECOM</connection><sql><![CDATA[
SELECT i.order_id, i.line_no, o.order_ts, o.status, o.customer_id, o.voucher_id, v.promo_code, v.valid_from AS voucher_valid_from,
       o.payment_method, i.sku, p.product_name, p.brand, c.category_name, pc.category_name AS parent_category,
       i.qty, i.unit_price, i.disc_amount,
       COALESCE(r.qty_retur, 0) AS qty_retur, COALESCE(r.refund, 0) AS refund_incl
FROM order_items i
JOIN orders o               ON o.order_id = i.order_id
LEFT JOIN vouchers v        ON v.voucher_id = o.voucher_id
LEFT JOIN products p        ON p.product_id = i.product_id
LEFT JOIN categories c      ON c.category_id = p.category_id
LEFT JOIN categories pc     ON pc.category_id = c.parent_category_id
LEFT JOIN (SELECT order_item_id, SUM(qty) AS qty_retur, SUM(refund_amount) AS refund
             FROM order_returns WHERE status = 'DISETUJUI' GROUP BY order_item_id) r ON r.order_item_id = i.order_item_id
]]></sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>80</xloc><yloc>260</yloc><draw>Y</draw></GUI></step><step><name>PPN 11% -> ex-PPN dan mapping SKU</name><type>ScriptValueMod</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Script</jsScript_name><jsScript_script><![CDATA[
function T(x) { if (x == null) return null; var s = ("" + x).replace(/^\s+|\s+$/g, ""); return s.length == 0 ? null : s; }
function NUM(x) { var s = T(x); return s == null ? null : parseFloat(s); }
function INT(x) { var s = T(x); return s == null ? null : parseInt(s, 10); }
function R2(x) { return Math.round(x * 100) / 100; }

var m = /^SKU-([0-9]+)-/.exec("" + sku);
var material_no = m ? ("P-" + m[1]) : ("" + sku);
var unit_excl = R2(unit_price / 1.11);
var disc_excl = R2(disc_amount / 1.11);
var refund_excl = R2(refund_incl / 1.11);
var payment_u = T(payment_method) == null ? null : T(payment_method).toUpperCase();
var promo_u = T(promo_code) == null ? null : T(promo_code).toUpperCase().replace(/\s+/g, "");
]]></jsScript_script></jsScript></jsScripts><fields><field><name>material_no</name><rename>material_no</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>unit_excl</name><rename>unit_excl</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>disc_excl</name><rename>disc_excl</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>refund_excl</name><rename>refund_excl</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>payment_u</name><rename>payment_u</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>promo_u</name><rename>promo_u</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>400</xloc><yloc>260</yloc><draw>Y</draw></GUI></step><step><name>stg_s1_order_line</name><type>TableOutput</type><description/><distribute>Y</distribute>
