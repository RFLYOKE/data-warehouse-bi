me></field><field><column_name>disc_amount_incl</column_name><stream_name>disc_amount</stream_name></field><field><column_name>unit_price_excl</column_name><stream_name>unit_excl</stream_name></field><field><column_name>disc_excl</column_name><stream_name>disc_excl</stream_name></field><field><column_name>qty_retur</column_name><stream_name>qty_retur</stream_name></field><field><column_name>refund_excl</column_name><stream_name>refund_excl</stream_name></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
