<step><name>S1 customers + alamat terpilih</name><type>TableInput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_ECOM</connection><sql><![CDATA[
SELECT c.customer_id, c.full_name, c.email, c.phone, c.gender, c.birth_date, c.registered_at, a.city, a.province
FROM customers c
LEFT JOIN customer_addresses a
  ON a.address_id = (SELECT x.address_id FROM customer_addresses x
                      WHERE x.customer_id = c.customer_id
                      ORDER BY x.is_primary DESC, x.address_id DESC LIMIT 1)
]]></sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>80</xloc><yloc>100</yloc><draw>Y</draw></GUI></step><step><name>Normalkan HP dan kota pelanggan</name><type>ScriptValueMod</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Script</jsScript_name><jsScript_script><![CDATA[
function T(x) { if (x == null) return null; var s = ("" + x).replace(/^\s+|\s+$/g, ""); return s.length == 0 ? null : s; }
function NUM(x) { var s = T(x); return s == null ? null : parseFloat(s); }
function INT(x) { var s = T(x); return s == null ? null : parseInt(s, 10); }
function R2(x) { return Math.round(x * 100) / 100; }

var d = T(phone) == null ? "" : T(phone).replace(/[^0-9]/g, "");
var phone_norm = null;
if (d.length > 0) {
    if (d.indexOf("62") == 0) phone_norm = d;
    else if (d.charAt(0) == "0") phone_norm = "62" + d.substring(1);
    else phone_norm = "62" + d;
}

var kota_upper = T(city) == null ? null : T(city).toUpperCase().replace(/\s+/g, " ");
]]></jsScript_script></jsScript></jsScripts><fields><field><name>phone_norm</name><rename>phone_norm</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>kota_upper</name><rename>kota_upper</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>330</xloc><yloc>100</yloc><draw>Y</draw></GUI></step><step><name>Kota baku pelanggan</name><type>DBLookup</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_DW</connection><cache>Y</cache><cache_size>0</cache_size><cache_load_all>Y</cache_load_all><lookup><schema/><table>stg_ref_kota</table><orderby/><fail_on_multiple>N</fail_on_multiple><eat_row_on_failure>N</eat_row_on_failure><key><name>kota_upper</name><field>alias_upper</field><condition>=</condition><name2/></key><value><name>kota_baku</name><rename>kota_lookup</rename><default/><type>String</type></value></lookup><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>540</xloc><yloc>100</yloc><draw>Y</draw></GUI></step><step><name>Kota pelanggan final</name><type>ScriptValueMod</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<compatible>N</compatible><optimizationLevel>9</optimizationLevel><jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Script</jsScript_name><jsScript_script><![CDATA[
function T(x) { if (x == null) return null; var s = ("" + x).replace(/^\s+|\s+$/g, ""); return s.length == 0 ? null : s; }
function NUM(x) { var s = T(x); return s == null ? null : parseFloat(s); }
function INT(x) { var s = T(x); return s == null ? null : parseInt(s, 10); }
function R2(x) { return Math.round(x * 100) / 100; }
var kota_final = T(kota_lookup) != null ? T(kota_lookup) : T(city);]]></jsScript_script></jsScript></jsScripts><fields><field><name>kota_final</name><rename>kota_final</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
