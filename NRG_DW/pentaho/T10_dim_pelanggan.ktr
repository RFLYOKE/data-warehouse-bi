<order><hop><from>Gabung web + member + marketplace</from><to>dim_pelanggan</to><enabled>Y</enabled></hop></order>
<step><name>Gabung web + member + marketplace</name><type>TableInput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_DW</connection><sql><![CDATA[
SELECT CASE WHEN m.member_no IS NULL THEN 'WEB_ONLY' ELSE 'OMNICHANNEL' END AS tipe_pelanggan,
       w.customer_id AS customer_id_web, m.member_no, CAST(NULL AS CHAR(20)) AS mpl_buyer_hash, w.phone_norm,
       w.full_name AS nama_pelanggan, w.gender, COALESCE(w.kota_baku, m.kota_baku) AS kota_baku, w.provinsi,
       w.registered_at AS tgl_daftar_web, m.join_date AS tgl_join_member,
       'Y' AS is_web_customer, CASE WHEN m.member_no IS NULL THEN 'N' ELSE 'Y' END AS is_member_toko
FROM stg_s1_customer w
LEFT JOIN stg_s2_member m ON m.phone_norm = w.phone_norm
UNION ALL
SELECT 'MEMBER_TOKO', CAST(NULL AS SIGNED), m.member_no, NULL, m.phone_norm, m.member_name, CAST(NULL AS CHAR(1)), m.kota_baku,
       CAST(NULL AS CHAR(60)), CAST(NULL AS DATETIME), m.join_date, 'N', 'Y'
FROM stg_s2_member m
WHERE NOT EXISTS (SELECT 1 FROM stg_s1_customer w WHERE w.phone_norm = m.phone_norm)
UNION ALL
SELECT 'MARKETPLACE', CAST(NULL AS SIGNED), NULL, b.buyer_hash, NULL, CONCAT('Pembeli marketplace ', b.buyer_hash), CAST(NULL AS CHAR(1)),
       b.kota_baku, CAST(NULL AS CHAR(60)), CAST(NULL AS DATETIME), CAST(NULL AS DATE), 'N', 'N'
FROM (SELECT buyer_hash, MAX(kota_baku) AS kota_baku FROM stg_s3_inv_item GROUP BY buyer_hash) b
]]></sql><limit>0</limit><lookup/><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>80</xloc><yloc>80</yloc><draw>Y</draw></GUI></step><step><name>dim_pelanggan</name><type>TableOutput</type><description/><distribute>Y</distribute>
<custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<connection>NRG_DW</connection><schema/><table>dim_pelanggan</table><commit>1000</commit><truncate>N</truncate><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields><partitioning_enabled>N</partitioning_enabled><partitioning_field/><partitioning_daily>N</partitioning_daily><partitioning_monthly>Y</partitioning_monthly><tablename_in_field>N</tablename_in_field><tablename_field/><tablename_in_table>Y</tablename_in_table><return_keys>N</return_keys><return_field/><fields><field><column_name>tipe_pelanggan</column_name><stream_name>tipe_pelanggan</stream_name></field><field><column_name>customer_id_web</column_name><stream_name>customer_id_web</stream_name></field><field><column_name>member_no</column_name><stream_name>member_no</stream_name></field><field><column_name>mpl_buyer_hash</column_name><stream_name>mpl_buyer_hash</stream_name></field><field><column_name>phone_norm</column_name><stream_name>phone_norm</stream_name></field><field><column_name>nama_pelanggan</column_name><stream_name>nama_pelanggan</stream_name></field><field><column_name>gender</column_name><stream_name>gender</stream_name></field><field><column_name>kota_baku</column_name><stream_name>kota_baku</stream_name></field><field><column_name>provinsi</column_name><stream_name>provinsi</stream_name></field><field><column_name>tgl_daftar_web</column_name><stream_name>tgl_daftar_web</stream_name></field><field><column_name>tgl_join_member</column_name><stream_name>tgl_join_member</stream_name></field><field><column_name>is_web_customer</column_name><stream_name>is_web_customer</stream_name></field><field><column_name>is_member_toko</column_name><stream_name>is_member_toko</stream_name></field></fields><cluster_schema/><remotesteps><input/><output/></remotesteps>
<GUI><xloc>400</xloc><yloc>80</yloc><draw>Y</draw></GUI></step>
